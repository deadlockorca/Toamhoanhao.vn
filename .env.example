# Sao chép file này thành `.env` rồi điền giá trị thật.
#   cp .env.example .env
#
# KHÔNG commit file `.env`. `.gitignore` đã chặn `.env*` và chỉ cho phép
# `.env.example` được đưa lên git.

# ---------------------------------------------------------------------------
# Cơ sở dữ liệu (bắt buộc)
# ---------------------------------------------------------------------------
# Ứng dụng thoát ngay khi khởi tạo nếu thiếu biến này (xem src/lib/prisma.ts).
# Database local của dự án chạy ở cổng 3307: npm run db:start
DATABASE_URL="mysql://toamhoanhao:mat_khau@127.0.0.1:3307/toamhoanhao"

# ---------------------------------------------------------------------------
# Domain công khai (bắt buộc trên production)
# ---------------------------------------------------------------------------
# Dùng để dựng canonical, hreflang và URL tuyệt đối cho OpenGraph.
# Nếu bỏ trống, ứng dụng fallback về https://toamhoanhao.vn
NEXT_PUBLIC_SITE_URL="https://toamhoanhao.vn"

# ---------------------------------------------------------------------------
# Cloudflare R2 — nơi lưu ảnh dự án và mẫu thiết kế (bắt buộc nếu dùng /admin)
# ---------------------------------------------------------------------------
# Thiếu bất kỳ biến nào trong nhóm R2_BUCKET / R2_ENDPOINT / R2_PUBLIC_BASE_URL /
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY thì thao tác tải ảnh sẽ báo lỗi
# "Thiếu cấu hình R2" (xem src/lib/r2-storage.ts).
R2_BUCKET=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_REGION="auto"
# Tiền tố thư mục cho mọi object, ví dụ "toamhoanhao". Để trống nếu không dùng.
R2_KEY_PREFIX=""
# Giới hạn dung lượng mỗi ảnh, tính bằng byte. Mặc định 8 MB nếu bỏ trống.
R2_MAX_FILE_SIZE_BYTES="8388608"

# ---------------------------------------------------------------------------
# SMTP — gửi email từ form liên hệ (bắt buộc nếu dùng form liên hệ)
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# "true" cho cổng 465 (SSL), "false" cho 587 (STARTTLS).
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Địa chỉ gửi đi. Thường phải trùng SMTP_USER để nhà cung cấp chấp nhận.
CONTACT_NOTIFICATION_FROM=""
# Địa chỉ nhận thông báo có yêu cầu tư vấn mới.
CONTACT_NOTIFICATION_TO=""
